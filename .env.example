# Every VITE_* value is public and visible in the browser bundle.
# Never place database, SMTP, service-role, private, or signing secrets here.

VITE_API_URL=http://localhost:8001
VITE_DISABLE_CACHE=false

# Defaults to /tonconnect-manifest.json on the current origin when omitted.
VITE_TONCONNECT_MANIFEST_URL=

# Public on-chain contract address. Required only for token sale functionality.
VITE_TOKEN_SELL_ADDRESS=

# Optional browser-visible key. Use a restricted key with minimal quota/scope.
VITE_TONAPI_KEY=
